---
/**
 * Terminverwaltung. Die zufaellige Adresse haelt Neugierige fern, sie ist
 * nicht verlinkt und nicht indexiert. Geschuetzt ist sie durch GitHub:
 * Ohne gueltigen Schluessel kann sie nichts lesen und nichts schreiben.
 */
import '../styles/tokens.css';

const repo = import.meta.env.PUBLIC_TERMINE_REPO ?? 'cfs-at-ada/germantcakulov-neu';
const zweig = import.meta.env.PUBLIC_TERMINE_ZWEIG ?? 'main';
const pfad = import.meta.env.PUBLIC_TERMINE_PFAD ?? '_neu/src/inhalte/termine.json';
const basis = import.meta.env.BASE_URL.replace(/\/$/, '');

// Vorbelegter Antrag fuer einen fein abgestimmten Schluessel
const schluesselAntrag =
  'https://github.com/settings/personal-access-tokens/new?' +
  new URLSearchParams({
    name: 'Terminverwaltung germantcakulov.com',
    description: 'Darf die Termine der Website lesen und schreiben.',
    target_name: repo.split('/')[0],
    expires_in: '366',
    contents: 'write',
    actions: 'read',
  }).toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Die Adresse soll nicht ueber Links nach aussen gelangen. -->
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#003049" />
    <title>Termine verwalten · German Tcakulov</title>
  </head>

  <body data-ansicht="laden" data-repo={repo} data-zweig={zweig} data-pfad={pfad} data-seite={`${basis}/Termine`}>

    <!-- ===================== Anmeldung ===================== -->
    <main class="anmeldung" data-nur="anmeldung">
      <div class="anmeldung__karte">
        <p class="marke">German<br />Tcakulov</p>
        <h1 class="anmeldung__titel">Terminverwaltung</h1>
        <p class="anmeldung__text">Melde dich mit deinem GitHub-Schlüssel an. Er bleibt nur auf diesem Gerät gespeichert.</p>

        <form class="anmeldung__form" data-anmeldeformular>
          <label class="feld">
            <span class="feld__name">Schlüssel</span>
            <span class="feld__mit-knopf">
              <input class="eingabe" name="schluessel" type="password" autocomplete="current-password"
                     placeholder="github_pat_…" required spellcheck="false" />
              <button class="knopf-zeigen" type="button" data-zeigen aria-label="Schlüssel anzeigen">Zeigen</button>
            </span>
          </label>

          <details class="erweitert">
            <summary>Repository</summary>
            <label class="feld">
              <span class="feld__name">Besitzer / Name</span>
              <input class="eingabe" name="repo" value={repo} spellcheck="false" />
            </label>
          </details>

          <p class="meldung meldung--fehler" data-anmeldefehler hidden></p>

          <button class="knopf knopf--haupt knopf--breit" type="submit">
            <span>Anmelden</span>
          </button>
        </form>

        <details class="hilfe">
          <summary>Wie bekomme ich einen Schlüssel?</summary>
          <ol>
            <li>Bei GitHub anmelden und <a href={schluesselAntrag} target="_blank" rel="noopener">diesen vorbereiteten Antrag öffnen</a>.</li>
            <li>Unter <em>Repository access</em> „Only select repositories“ wählen und <strong>{repo.split('/')[1]}</strong> auswählen.</li>
            <li>Die Rechte <em>Contents: Read and write</em> und <em>Actions: Read</em> sind schon gesetzt.</li>
            <li>„Generate token“ – den Schlüssel kopieren und hier einfügen.</li>
          </ol>
          <p>Der Schlüssel darf nur dieses eine Repository ändern. Läuft er ab, einfach einen neuen erstellen.</p>
        </details>
      </div>
    </main>

    <!-- ===================== Uebersicht ===================== -->
    <div class="app" data-nur="app">
      <header class="kopf">
        <div class="kopf__innen">
          <a class="kopf__marke" href={`${basis}/Termine`} target="_blank" rel="noopener" title="Terminseite öffnen">
            <span class="marke marke--klein">German Tcakulov</span>
            <span class="kopf__unter">Terminverwaltung</span>
          </a>
          <div class="kopf__nutzer">
            <img class="kopf__bild" data-nutzerbild alt="" width="32" height="32" hidden />
            <button class="knopf knopf--leise" type="button" data-abmelden>Abmelden</button>
          </div>
        </div>
      </header>

      <main class="uebersicht">
        <div class="uebersicht__kopf">
          <h1 class="uebersicht__titel">Termine</h1>
          <button class="knopf knopf--haupt" type="button" data-neu>
            <span class="plus" aria-hidden="true"></span><span>Neuer Termin</span>
          </button>
        </div>

        <div class="werkzeuge">
          <div class="reiter" role="tablist">
            <button role="tab" class="reiter__knopf" aria-selected="true" data-reiter="kommend">
              Kommend <span class="reiter__zahl" data-zahl="kommend">0</span>
            </button>
            <button role="tab" class="reiter__knopf" aria-selected="false" data-reiter="archiv">
              Archiv <span class="reiter__zahl" data-zahl="archiv">0</span>
            </button>
          </div>
          <label class="suche">
            <span class="suche__lupe" aria-hidden="true"></span>
            <input class="eingabe eingabe--suche" type="search" placeholder="Suchen …" data-suche aria-label="Termine durchsuchen" />
          </label>
        </div>

        <ol class="liste" data-liste aria-live="polite"></ol>
        <div class="leer" data-leer hidden>
          <p class="leer__titel" data-leer-titel>Keine kommenden Termine</p>
          <p class="leer__text">Lege mit „Neuer Termin“ den nächsten an.</p>
        </div>
        <div class="ladeplatz" data-ladeplatz>
          <span class="kreisel"></span>
        </div>
      </main>
    </div>

    <!-- ===================== Bearbeiten ===================== -->
    <dialog class="tafel" data-tafel aria-labelledby="tafel-titel">
      <form class="tafel__form" data-terminformular novalidate>
        <header class="tafel__kopf">
          <button class="knopf-zurueck" type="button" data-schliessen aria-label="Schließen"></button>
          <h2 class="tafel__titel" id="tafel-titel" data-tafel-titel>Neuer Termin</h2>
        </header>

        <div class="tafel__rumpf">
          <section class="gruppe">
            <h3 class="gruppe__titel">Art</h3>
            <div class="wahl" role="radiogroup">
              <label class="wahl__punkt"><input type="radio" name="typ" value="konzert" checked /><span>Konzert</span></label>
              <label class="wahl__punkt"><input type="radio" name="typ" value="meisterkurs" /><span>Meisterkurs</span></label>
              <label class="wahl__punkt"><input type="radio" name="typ" value="sonstiges" /><span>Sonstiges</span></label>
            </div>
            <p class="gruppe__hinweis" data-typhinweis>Erscheint auf der Startseite als „Nächstes Konzert“.</p>
          </section>

          <section class="gruppe">
            <h3 class="gruppe__titel">Wann</h3>
            <div class="reihe reihe--datum">
              <label class="feld">
                <span class="feld__name">Datum</span>
                <input class="eingabe" type="date" name="start" required />
              </label>
              <label class="feld" data-endfeld hidden>
                <span class="feld__name">bis</span>
                <input class="eingabe" type="date" name="ende" />
              </label>
              <label class="feld feld--uhrzeit">
                <span class="feld__name">Beginn <span class="feld__bsp">optional</span></span>
                <input class="eingabe" type="time" name="uhrzeit" step="300" />
              </label>
            </div>
            <label class="schalter">
              <input type="checkbox" name="mehrtaegig" />
              <span class="schalter__bahn" aria-hidden="true"></span>
              <span>Mehrere Tage</span>
            </label>
          </section>

          <section class="gruppe">
            <h3 class="gruppe__titel">Wo und was</h3>
            <div class="sprachkopf" aria-hidden="true">
              <span>Deutsch</span><span>English</span>
            </div>

            <div class="paar">
              <label class="feld">
                <span class="feld__name">Ort <span class="feld__bsp">Land, Stadt</span></span>
                <input class="eingabe" name="ort_de" list="orte" placeholder="Österreich, Wien" required autocomplete="off" />
              </label>
              <label class="feld">
                <span class="feld__name">Place <span class="feld__auto" data-auto-hinweis="ort_en">automatisch</span></span>
                <input class="eingabe" name="ort_en" placeholder="Austria, Vienna" required autocomplete="off" />
              </label>
            </div>

            <div class="paar">
              <label class="feld">
                <span class="feld__name">Erste Zeile</span>
                <input class="eingabe" name="titel_de" placeholder="Konzert im Bechstein Centrum Wien" required />
              </label>
              <label class="feld">
                <span class="feld__name">First line <span class="feld__auto" data-auto-hinweis="titel_en">automatisch</span></span>
                <input class="eingabe" name="titel_en" placeholder="Concert at Bechstein Centrum Vienna" required />
              </label>
            </div>

            <div class="paar">
              <label class="feld">
                <span class="feld__name">Zweite Zeile <span class="feld__bsp">optional</span></span>
                <input class="eingabe" name="zusatz_de" placeholder="mit Elena Nemtsova" />
              </label>
              <label class="feld">
                <span class="feld__name">Second line <span class="feld__auto" data-auto-hinweis="zusatz_en">automatisch</span></span>
                <input class="eingabe" name="zusatz_en" placeholder="with Elena Nemtsova" />
              </label>
            </div>
            <div class="paar">
              <label class="feld">
                <span class="feld__name">Programm <span class="feld__bsp">optional, ein Werk pro Zeile</span></span>
                <textarea class="eingabe eingabe--mehrzeilig" name="programm_de" rows="3" placeholder="Brahms: Sonate f-Moll op. 120 Nr. 1&#10;Schumann: Märchenbilder op. 113"></textarea>
              </label>
              <label class="feld">
                <span class="feld__name">Programme <span class="feld__bsp">leer = wie Deutsch</span></span>
                <textarea class="eingabe eingabe--mehrzeilig" name="programm_en" rows="3" placeholder="Brahms: Sonata in F minor, Op. 120 No. 1"></textarea>
              </label>
            </div>
            <datalist id="orte" data-orte></datalist>
          </section>

          <section class="gruppe">
            <h3 class="gruppe__titel">Links</h3>
            <label class="feld">
              <span class="feld__name">Infos zur Veranstaltung <span class="feld__bsp">optional</span></span>
              <input class="eingabe" type="url" name="link_de" placeholder="https://…" inputmode="url" spellcheck="false" />
            </label>
            <label class="feld">
              <span class="feld__name">Tickets <span class="feld__bsp">optional, direkt zum Kartenkauf</span></span>
              <input class="eingabe" type="url" name="tickets" placeholder="https://…" inputmode="url" spellcheck="false" />
            </label>
            <label class="schalter">
              <input type="checkbox" name="eigener_link_en" />
              <span class="schalter__bahn" aria-hidden="true"></span>
              <span>Eigene Adresse für die englische Seite</span>
            </label>
            <label class="feld" data-link-en hidden>
              <span class="feld__name">Englische Adresse</span>
              <input class="eingabe" type="url" name="link_en" placeholder="https://…" inputmode="url" spellcheck="false" />
            </label>
          </section>

          <section class="gruppe">
            <h3 class="gruppe__titel">Status</h3>
            <label class="schalter">
              <input type="checkbox" name="abgesagt" />
              <span class="schalter__bahn" aria-hidden="true"></span>
              <span>Abgesagt</span>
            </label>
            <p class="gruppe__hinweis" data-absagehinweis>Ein abgesagter Termin bleibt eine Woche lang ausgegraut mit dem Hinweis „Abgesagt“ sichtbar. Danach verschwindet er von selbst – auch aus dem Archiv.</p>
          </section>

          <section class="gruppe gruppe--vorschau">
            <div class="vorschau__kopf">
              <h3 class="gruppe__titel">Vorschau</h3>
              <div class="mini-reiter">
                <button type="button" class="mini-reiter__knopf" aria-pressed="true" data-vorschau-sprache="de">DE</button>
                <button type="button" class="mini-reiter__knopf" aria-pressed="false" data-vorschau-sprache="en">EN</button>
              </div>
            </div>
            <div class="vorschau" data-vorschau></div>
          </section>

          <p class="meldung meldung--fehler" data-formularfehler hidden></p>
        </div>

        <footer class="tafel__fuss">
          <button class="knopf knopf--gefahr" type="button" data-loeschen hidden>Löschen</button>
          <span class="tafel__luecke"></span>
          <button class="knopf knopf--leise" type="button" data-schliessen>Abbrechen</button>
          <button class="knopf knopf--haupt" type="submit" data-speichern>Speichern</button>
        </footer>
      </form>
    </dialog>

    <!-- ===================== Rueckfrage ===================== -->
    <dialog class="rueckfrage" data-rueckfrage>
      <form method="dialog">
        <h2 class="rueckfrage__titel">Termin löschen?</h2>
        <p class="rueckfrage__text" data-rueckfrage-text></p>
        <div class="rueckfrage__knoepfe">
          <button class="knopf knopf--leise" value="nein">Behalten</button>
          <button class="knopf knopf--gefahr-voll" value="ja">Löschen</button>
        </div>
      </form>
    </dialog>

    <!-- ===================== Statusmeldung ===================== -->
    <div class="status" data-status role="status" aria-live="polite" hidden>
      <span class="status__zeichen" data-status-zeichen></span>
      <span class="status__text">
        <strong data-status-titel></strong>
        <span data-status-text></span>
      </span>
      <a class="status__link" data-status-link href="#" target="_blank" rel="noopener" hidden>Ansehen</a>
    </div>

    <script>
      import '../verwaltung/app';
    </script>
  </body>
</html>

<style is:global>
  /* Die Verwaltung erbt Farben und Schrift der Website, sonst nichts. */

  :root {
    --flaeche: color-mix(in srgb, var(--farbe-grund) 88%, white);
    --flaeche-hoch: color-mix(in srgb, var(--farbe-grund) 80%, white);
    --linie: color-mix(in srgb, var(--farbe-akzent) 35%, transparent);
    --linie-stark: color-mix(in srgb, var(--farbe-akzent) 70%, transparent);
    --gedaempft: color-mix(in srgb, var(--farbe-text) 62%, var(--farbe-grund));
    --rot: #E8806F;
    --gruen: #9CCB9B;
    --radius: 12px;
    --schatten: 0 18px 50px rgba(0, 10, 20, 0.45);
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--farbe-grund);
    color: var(--farbe-text);
    font-family: var(--schrift);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  button, input, select, textarea { font: inherit; color: inherit; }
  a { color: var(--farbe-akzent-hell); }
  [hidden] { display: none !important; }

  /* Welche Ansicht gerade gilt, steuert ein Attribut am body. */
  body:not([data-ansicht="anmeldung"]) [data-nur="anmeldung"],
  body:not([data-ansicht="app"]) [data-nur="app"] { display: none; }

  body[data-ansicht="laden"]::after {
    content: '';
    position: fixed;
    inset: 50% auto auto 50%;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border: 2px solid var(--linie);
    border-top-color: var(--farbe-akzent-hell);
    border-radius: 50%;
    animation: drehen 0.8s linear infinite;
  }

  @keyframes drehen { to { transform: rotate(360deg); } }

  .marke {
    margin: 0;
    font-size: 2.6rem;
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--farbe-akzent-hell);
  }

  .marke--klein {
    font-size: 1.15rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  /* --- Knoepfe ------------------------------------------------------------ */

  .knopf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 44px;
    padding: 0 1.15em;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .knopf:active { transform: scale(0.97); }
  .knopf:disabled { opacity: 0.55; cursor: progress; }

  .knopf--haupt { background: var(--farbe-akzent-hell); color: var(--farbe-grund); }
  .knopf--haupt:hover { background: var(--farbe-text); }

  .knopf--leise { border-color: var(--linie); color: var(--farbe-akzent-hell); }
  .knopf--leise:hover { border-color: var(--farbe-akzent-hell); }

  .knopf--gefahr { color: var(--rot); padding-inline: 0.6em; }
  .knopf--gefahr:hover { background: color-mix(in srgb, var(--rot) 12%, transparent); }

  .knopf--gefahr-voll { background: var(--rot); color: #2B0F0A; }

  .knopf--breit { width: 100%; }

  .knopf:focus-visible,
  .eingabe:focus-visible,
  .reiter__knopf:focus-visible,
  .karte:focus-visible {
    outline: 2px solid var(--farbe-akzent-hell);
    outline-offset: 2px;
  }

  .plus {
    position: relative;
    width: 12px;
    height: 12px;
  }

  .plus::before, .plus::after {
    content: '';
    position: absolute;
    inset: 5px 0 auto 0;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }

  .plus::after { transform: rotate(90deg); }

  /* --- Felder ------------------------------------------------------------- */

  .feld { display: flex; flex-direction: column; gap: 0.35em; min-width: 0; }

  .feld__name {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--farbe-akzent-hell);
  }

  .feld__bsp, .feld__auto {
    font-weight: 400;
    color: var(--gedaempft);
  }

  .feld__auto {
    padding: 0 0.5em;
    border-radius: 999px;
    font-size: 0.75rem;
    background: color-mix(in srgb, var(--farbe-akzent) 22%, transparent);
    color: var(--farbe-akzent-hell);
  }

  .eingabe {
    width: 100%;
    min-height: 46px;
    padding: 0.55em 0.85em;
    border: 1px solid var(--linie);
    border-radius: 10px;
    background: color-mix(in srgb, var(--farbe-grund) 70%, black);
    color: var(--farbe-text);
    font-size: 1rem; /* 16px – sonst zoomt iOS beim Antippen */
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .eingabe::placeholder { color: color-mix(in srgb, var(--farbe-text) 32%, transparent); }
  .eingabe:hover { border-color: var(--linie-stark); }
  .eingabe:focus { outline: none; border-color: var(--farbe-akzent-hell); background: color-mix(in srgb, var(--farbe-grund) 82%, black); }
  .eingabe[aria-invalid="true"] { border-color: var(--rot); }

  .eingabe[type="date"] { min-width: 0; }
  .eingabe[type="date"]::-webkit-calendar-picker-indicator { filter: invert(0.85) sepia(0.4); cursor: pointer; }

  .meldung {
    margin: 0;
    padding: 0.75em 1em;
    border-radius: 10px;
    font-size: 0.92rem;
  }

  .meldung--fehler {
    border: 1px solid color-mix(in srgb, var(--rot) 55%, transparent);
    background: color-mix(in srgb, var(--rot) 12%, transparent);
    color: #F6C2B8;
  }

  /* --- Anmeldung ---------------------------------------------------------- */

  .anmeldung {
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 24px 16px;
    background:
      radial-gradient(120% 70% at 85% 0%, color-mix(in srgb, var(--farbe-akzent) 22%, transparent), transparent 60%),
      var(--farbe-grund);
  }

  .anmeldung__karte {
    width: min(100%, 420px);
  }

  .anmeldung__titel {
    margin: 1.6rem 0 0.4rem;
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--farbe-akzent);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .anmeldung__text { margin: 0 0 1.6rem; color: var(--gedaempft); }

  .anmeldung__form { display: flex; flex-direction: column; gap: 1rem; }

  .feld__mit-knopf { position: relative; display: block; }
  .feld__mit-knopf .eingabe { padding-right: 5.2em; }

  .knopf-zeigen {
    position: absolute;
    top: 50%;
    right: 6px;
    transform: translateY(-50%);
    padding: 0.35em 0.7em;
    border: 0;
    border-radius: 8px;
    background: color-mix(in srgb, var(--farbe-akzent) 18%, transparent);
    font-size: 0.8rem;
    color: var(--farbe-akzent-hell);
    cursor: pointer;
  }

  .erweitert summary, .hilfe summary {
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--farbe-akzent);
  }

  .erweitert[open] summary { margin-bottom: 0.6rem; }

  .hilfe {
    margin-top: 1.8rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--linie);
    font-size: 0.92rem;
    color: var(--gedaempft);
  }

  .hilfe ol { padding-left: 1.2em; margin: 0.8rem 0; }
  .hilfe li { margin-bottom: 0.4em; }
  .hilfe em, .hilfe strong { color: var(--farbe-text); }

  /* --- Kopfleiste --------------------------------------------------------- */

  .kopf {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-top: env(safe-area-inset-top);
    border-bottom: 1px solid var(--linie);
    background: color-mix(in srgb, var(--farbe-grund) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .kopf__innen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100% - 32px, 880px);
    min-height: 64px;
    margin-inline: auto;
  }

  .kopf__marke { display: flex; flex-direction: column; gap: 3px; text-decoration: none; }
  .kopf__unter { font-size: 0.78rem; color: var(--farbe-akzent); letter-spacing: 0.02em; }

  .kopf__nutzer { display: flex; align-items: center; gap: 0.75rem; }
  .kopf__bild { border-radius: 50%; border: 1px solid var(--linie); }

