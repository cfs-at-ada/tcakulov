---
import { pfad } from '../inhalte/pfad';
import '../styles/tokens.css';
import '../styles/basis.css';
import '../styles/layout.css';
import '../styles/elemente.css';

import Navigation from '../components/Navigation.astro';
import Menuetafel from '../components/Menuetafel.astro';
import Fusszeile from '../components/Fusszeile.astro';

import { sprachwechsel, type Seitenschluessel, type Sprache } from '../inhalte/navigation';
import { seo } from '../inhalte/seo';
import { teilbild } from '../inhalte/bilder';

interface Props {
  sprache: Sprache;
  /** Welche Seite gerade offen ist – steuert den Sprachwechsel. */
  seite: Seitenschluessel;
  /** Welcher Navigationspunkt hervorgehoben wird. */
  aktiv?: Seitenschluessel;
  /** Sprungmarke, auf die der hervorgehobene Punkt zeigt. */
  marke?: string;
  /** Abstand der Trennlinie ueber der Fusszeile. */
  fusszeileAbstand: string;
  /** Die Startseite laeuft in einer schmaleren Bahn. */
  schmal?: boolean;
  /** Impressum behaelt den oberen Rasterabstand. */
  rasterAbstand?: boolean;
  /** Strukturierte Daten (schema.org) fuer Suchmaschinen. */
  strukturdaten?: object;
  /** Seiten, die nicht in Suchmaschinen erscheinen sollen. */
  nichtIndexieren?: boolean;
}

const {
  sprache,
  seite,
  aktiv,
  marke,
  fusszeileAbstand,
  schmal = false,
  rasterAbstand = false,
  strukturdaten,
  nichtIndexieren = false,
} = Astro.props;

// Die eigene Adresse ist das Gegenstueck des Gegenstuecks – ohne `.html`.
const andere: Sprache = sprache === 'de' ? 'en' : 'de';
const adresse = (ziel: string) => new URL(ziel, Astro.site).href;
const eigene = adresse(sprachwechsel[andere][seite]);
const gegenstueck = adresse(sprachwechsel[sprache][seite]);
const deutsch = sprache === 'de' ? eigene : gegenstueck;
const { titel, beschreibung } = seo[sprache][seite];
const vorschaubild = adresse((await teilbild()).src);
// Vorschau (z. B. auf github.io): Suchmaschinen sollen nur die echte Domain kennen.
const vorschau = !Astro.site?.hostname.endsWith('germantcakulov.com');
const mitTitelbild = Astro.slots.has('titelbild');
---

<!doctype html>
<html lang={sprache}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    {(nichtIndexieren || vorschau) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={eigene} />
    <link rel="alternate" hreflang={sprache} href={eigene} />
    <link rel="alternate" hreflang={andere} href={gegenstueck} />
    <link rel="alternate" hreflang="x-default" href={deutsch} />

    <meta property="og:type" content={seite === 'vita' ? 'profile' : 'website'} />
    <meta property="og:site_name" content="German Tcakulov" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={eigene} />
    <meta property="og:locale" content={sprache === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:locale:alternate" content={sprache === 'de' ? 'en_GB' : 'de_DE'} />
    <meta property="og:image" content={vorschaubild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={sprache === 'de' ? 'German Tcakulov mit Bratsche' : 'German Tcakulov with viola'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={pfad('/favicon-192.png')} sizes="192x192" type="image/png" />
    <link rel="icon" href={pfad('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={pfad('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#003049" />
    {strukturdaten && <script type="application/ld+json" set:html={JSON.stringify(strukturdaten)} />}
    <slot name="kopf" />
  </head>

  <body class:list={['is-preload', { 'ohne-titelbild': !mitTitelbild }]}>
    <div id="seitenrumpf">
      <slot name="titelbild" />

      <Navigation sprache={sprache} seite={seite} aktiv={aktiv} marke={marke} />

      <section id="hauptteil" class:list={[{ schmal }]}>
        <div class="inhalt">
          <div class:list={['raster', { 'ohne-abstand-oben': !rasterAbstand }]}>
            <div class="spalte-12">
              <slot />
            </div>
          </div>
        </div>
      </section>

      <Fusszeile sprache={sprache} abstandOben={fusszeileAbstand} />
    </div>

    <Menuetafel sprache={sprache} seite={seite} aktiv={aktiv} marke={marke} mitTitelbild={mitTitelbild} />

    <script>
      import '../skripte/start';
    </script>
  </body>
</html>
