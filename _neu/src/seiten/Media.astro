---
import Grundgeruest from '../layouts/Grundgeruest.astro';
import Titelbild from '../components/Titelbild.astro';
import { galerie, videos, spotifyAlbum, medienTexte } from '../inhalte/medien';
import type { Sprache } from '../inhalte/navigation';

interface Props {
  sprache: Sprache;
}

const { sprache } = Astro.props;
const texte = medienTexte[sprache];
const presseZiel = sprache === 'de' ? '/Presse.html' : '/Presse-en.html';
---

<Grundgeruest
  sprache={sprache}
  seite="media"
  aktiv="media"
  marke="#jumphere"
  fusszeileAbstand="4.65em"
>
  <Fragment slot="kopf">
    <link rel="preconnect" href="https://www.youtube-nocookie.com" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://open.spotify.com" crossorigin />
    <link rel="prefetch" href={spotifyAlbum} as="document" crossorigin />
    {videos.map((v) => <link rel="prefetch" href={v} as="document" crossorigin />)}
  </Fragment>

  <Titelbild slot="titelbild" seite="media" />

  <section class="mediakopf">
    <div class="mediakopf__zeile">
      <h2 class="mediakopf__titel sprungmarke-oben">{texte.titel}</h2>
      <h3 class="mediakopf__presse">
        <a href={presseZiel} class="mail-link">{texte.presse}</a>
      </h3>
    </div>
  </section>

  <article class="medien">
    <div class="raster raster--medien">
      {galerie.map((bild) => (
        <div class="medien__feld galerie__kachel" data-gross={bild.datei}>
          <img class="medien__bild" src={bild.datei} alt="German Tcakulov" width="1980" height="1320" />
          <div class="medien__nachweis">{bild.nachweis}</div>
        </div>
      ))}

      {videos.map((quelle) => (
        <div class="medien__feld medien__video">
          <div class="medien__rahmen">
            <iframe
              src={quelle}
              title="German Tcakulov"
              frameborder="0"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      ))}

      <div class="medien__feld medien__spotify">
        <iframe
          src={spotifyAlbum}
          title="Album bei Spotify"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </article>
</Grundgeruest>

<style>
  .mediakopf {
    margin-top: 0.65em;
    margin-bottom: 2em;
    padding-bottom: 1.275em;
    color: var(--farbe-akzent);
  }

  .mediakopf__zeile {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: -1em;
  }

  .mediakopf__titel {
    margin: 0.725em 0 0.5em 0;
    font-size: 3em;
    font-weight: 400;
    color: var(--farbe-akzent);
  }

  .mediakopf__presse {
    margin: 0;
    font-size: 1.25em;
    font-weight: 300;
    text-transform: none;
    color: var(--farbe-akzent);
  }

  .mediakopf__presse a {
    color: inherit;
    text-decoration: none;
    text-transform: none;
  }

  .medien {
    margin: 0;
    padding: 0;
  }

  .raster.raster--medien {
    gap: 3em 3.8em;
    margin: 0;
    padding: 0;
  }

  .raster > .medien__feld {
    flex: 1 1 45%;
    padding: 0;
    text-align: center;
  }

  .medien__bild {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .medien__nachweis {
    margin-top: 0.4em;
    font-size: 0.8em;
    line-height: 1;
    color: var(--farbe-akzent);
  }

  .raster > .medien__video { padding-bottom: 0.9em; }

  .medien__rahmen {
    position: relative;
    height: 0;
    padding-bottom: 66.5%;
    max-width: 100%;
    overflow: hidden;
  }

  .medien__rahmen iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .raster > .medien__spotify {
    max-height: 150px;
    padding: 0 0.1em 0 0;
  }

  .medien__spotify iframe {
    display: block;
    width: 100%;
    height: 300px;
    margin: 0 auto;
    border: none;
  }

  /* Die Grossansicht entsteht erst beim Klick, darum unbeschraenkt. */
  :global(.bildschau) {
    position: fixed;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.6);
  }

  :global(.bildschau img) {
    max-width: 90%;
    max-height: 90%;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
  }
</style>
