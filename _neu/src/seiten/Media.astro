---
import { pfad } from '../inhalte/pfad';
import Grundgeruest from '../layouts/Grundgeruest.astro';
import Titelbild from '../components/Titelbild.astro';
import Einbettung from '../components/Einbettung.astro';
import { Picture } from 'astro:assets';
import { galerie, videos, spotifyAlbum, medienTexte } from '../inhalte/medien';
import { grossansicht } from '../inhalte/bilder';
import type { Sprache } from '../inhalte/navigation';

interface Props {
  sprache: Sprache;
}

const { sprache } = Astro.props;
const texte = medienTexte[sprache];
const presseZiel = sprache === 'de' ? pfad('/Presse') : pfad('/Presse-en');
const grosseBilder = await Promise.all(galerie.map((g) => grossansicht(g.bild)));
---

<Grundgeruest
  sprache={sprache}
  seite="media"
  aktiv="media"
  marke="#jumphere"
  fusszeileAbstand="4.65em"
>
  <Titelbild slot="titelbild" seite="media" />

  <section class="mediakopf">
    <div class="mediakopf__zeile">
      <h2 class="mediakopf__titel sprungmarke-oben">{texte.titel}</h2>
      <h3 class="mediakopf__presse">
        <a href={presseZiel} class="mail-link">{texte.presse}</a>
      </h3>
    </div>
  </section>

  <article class="medien">
    <div class="raster raster--medien">
      {galerie.map((g, stelle) => (
        <div class="medien__feld galerie__kachel" data-gross={grosseBilder[stelle]} data-alt={g.alt[sprache]}>
          <button type="button" class="galerie__knopf" aria-label={`${texte.grossansicht}: ${g.alt[sprache]}`}>
            <Picture
              class="medien__bild"
              src={g.bild}
              alt={g.alt[sprache]}
              widths={[480, 800, 1200]}
              sizes="(max-width: 980px) calc(100vw - 2 * var(--rand)), 26em"
              formats={['webp']}
              fallbackFormat="jpg"
              quality={82}
              loading={stelle < 2 ? 'eager' : 'lazy'}
            />
          </button>
          <div class="medien__nachweis">{g.nachweis}</div>
        </div>
      ))}

      {videos.map((video) => (
        <div class="medien__feld medien__video">
          <Einbettung eintrag={video} sprache={sprache} />
        </div>
      ))}

      <div class="medien__feld medien__spotify">
        <Einbettung eintrag={spotifyAlbum} sprache={sprache} />
      </div>
    </div>
  </article>
</Grundgeruest>

<style>
  .mediakopf {
    margin-top: 0.65em;
    margin-bottom: 2em;
    padding-bottom: 1.275em;
    color: var(--farbe-akzent);
  }

  .mediakopf__zeile {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: -1em;
  }

  .mediakopf__titel {
    margin: 0.725em 0 0.5em 0;
    font-size: 3em;
    font-weight: 400;
    color: var(--farbe-akzent);
  }

  .mediakopf__presse {
    margin: 0;
    font-size: 1.25em;
    font-weight: 300;
    text-transform: none;
    color: var(--farbe-akzent);
  }

  .mediakopf__presse a {
    color: inherit;
    text-decoration: none;
    text-transform: none;
  }

  .medien {
    margin: 0;
    padding: 0;
  }

  .raster.raster--medien {
    gap: 3em 3.8em;
    margin: 0;
    padding: 0;
  }

  .raster > .medien__feld {
    flex: 1 1 45%;
    padding: 0;
    text-align: center;
  }

  .medien__bild {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .medien__nachweis {
    margin-top: 0.4em;
    font-size: 0.8em;
    line-height: 1;
    color: var(--farbe-akzent);
  }

  .raster > .medien__video { padding-bottom: 0.9em; }

  .galerie__knopf {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .galerie__knopf :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .raster > .medien__spotify { padding: 0 0.1em 0 0; }

  /* Die Grossansicht entsteht erst beim Klick, darum unbeschraenkt. */
  :global(.bildschau) {
    position: fixed;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.6);
  }

  :global(.bildschau img) {
    max-width: 90%;
    max-height: 90%;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
  }
</style>
