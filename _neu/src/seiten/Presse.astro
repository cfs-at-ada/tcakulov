---
import Grundgeruest from '../layouts/Grundgeruest.astro';
import Symbol from '../components/Symbol.astro';
import { Picture } from 'astro:assets';
import { presse, pressefotos } from '../inhalte/presse';
import type { Sprache } from '../inhalte/navigation';

interface Props {
  sprache: Sprache;
}

const { sprache } = Astro.props;
const inhalt = presse[sprache];

/** Die vier Dokumente stehen wie im Original in zwei Reihen zu je zwei Kacheln. */
const reihen = [
  { paar: inhalt.dokumente.slice(0, 2), abstand: '4.4em' },
  { paar: inhalt.dokumente.slice(2, 4), abstand: '2.35em' },
];

---

<Grundgeruest
  sprache={sprache}
  seite="presse"
  aktiv="media"
  fusszeileAbstand="3.85em"
>
  <article class="presse">
    <section class="pressekopf">
      <h2 class="pressekopf__titel">{inhalt.titel}</h2>
      <p>{inhalt.hinweis}</p>
    </section>

    <section class="presse-bio" aria-labelledby="presse-bio-titel">
      <div class="presse-bio__kopf">
        <h3 id="presse-bio-titel">{inhalt.bioTitel}</h3>
        <button type="button" class="presse-bio__kopieren" data-kopieren="#presse-bio-text" data-fertig={inhalt.kopiert}>
          {inhalt.kopieren}
        </button>
      </div>
      <div class="presse-bio__text" id="presse-bio-text">
        {inhalt.kurzbio.split('\n\n').map((absatz) => <p>{absatz}</p>)}
      </div>
      <p class="presse-bio__stand">{inhalt.bioStand}</p>
    </section>

    {reihen.map(({ paar, abstand }) => (
      <div class="presse-reihe" style={`margin-bottom: ${abstand}`}>
        {paar.map((dokument, stelle) => (
          <a class="presse-dokument" href={dokument.datei} download title={inhalt.ladetitel}>
            <span class:list={['presse-kachel', { 'presse-zweit': stelle === 1 }]} aria-hidden="true">
              <Symbol name="dokument" class="presse-symbol" />
            </span>
            <span class="presse-lade" aria-hidden="true">
              <Symbol name="laden" class="presse-symbol" />
            </span>
            <span class="presse-text"><span class="presse-text__zeilen">{dokument.zeile1}<br /> {dokument.zeile2}</span></span>
          </a>
        ))}
      </div>
    ))}

    {pressefotos.map((foto) => (
      <div class="presse-foto">
        <div class="presse-foto__zeile">
          <div class="presse-foto__bild">
            <Picture
              src={foto.bild}
              alt={`${inhalt.fototext}, ${foto.nachweis}`}
              widths={[160, 320]}
              sizes="160px"
              formats={['webp']}
              fallbackFormat="jpg"
              quality={80}
              loading="lazy"
            />
          </div>

          <a href={foto.archiv} download title={inhalt.ladetitel} class="presse-lade" aria-label={`${inhalt.ladetitel}: ${inhalt.fototext} ${foto.groesse}`}>
            <Symbol name="laden" class="presse-symbol" />
          </a>

          <div class="presse-foto__text">
            <p>
              {inhalt.fototext} <span class="presse-foto__groesse">{foto.groesse}</span><br />
              <span class="presse-foto__nachweis">{foto.nachweis} · {inhalt.fotoformat}</span>
            </p>
          </div>
        </div>
      </div>
    ))}
  </article>
</Grundgeruest>

<style>
  .presse {
    margin: 0;
    padding: 0;
    font-weight: 100;
  }

  /* Ueberschrift und Nutzungshinweis */

  .pressekopf {
    margin: 0 0 2em 0;
    color: var(--farbe-akzent-hell);
    text-align: var(--blocksatz);
  }

  .pressekopf__titel {
    margin: 1.55em 0 0 -0.1em;
    padding-bottom: 1.3em;
    font-size: 3em;
    font-weight: 400;
    color: var(--farbe-akzent);
  }

  .pressekopf p {
    margin: 0;
    padding-bottom: 2em;
    font-weight: 100;
  }

  /* Die vier Textdokumente in zwei Reihen wie im Original. Jeder Verweis
     loest sich auf dem Rechner in seine drei Teile auf (display: contents),
     damit die Reihe genau wie die Vorlage aufgeteilt wird. */

  .presse-reihe {
    display: flex;
    align-items: center;
    gap: 0 2.5em;
    margin-top: 0;
    padding: 0;
  }

  .presse-dokument {
    display: contents;
    color: inherit;
    text-decoration: none;
  }

  .presse-kachel {
    display: flex;
    box-sizing: border-box;
    flex: 0 0 160px;
    align-items: center;
    justify-content: center;
    height: 110px;
    border: 1px solid var(--farbe-akzent);
    border-radius: 8px;
    background-color: var(--farbe-kachel);
    transition: border-color 0.3s ease;
  }

  .presse-kachel :global(.presse-symbol) {
    font-size: 2.5em;
    color: var(--farbe-akzent);
    /* Das Wortsymbol sitzt optisch etwas tiefer als die Mitte. */
    transform: translateY(10%);
  }

  .presse-kachel.presse-zweit { margin-left: 5em; }

  .presse-dokument:hover .presse-kachel { border-color: var(--farbe-akzent-hell); }

  .presse-text { flex: 1; }

  .presse-text__zeilen {
    display: block;
    font-size: 0.95em;
    font-weight: 100;
    color: var(--farbe-text);
  }

  /* Das Original blendet hier die zweite Spalte aus („Lang“ war dann nicht
     mehr zu erreichen). Stattdessen rutscht sie in eine eigene Zeile. */
  @media screen and (max-width: 800px) {
    .presse-reihe {
      flex-wrap: wrap;
      gap: 2.35em 0;
    }

    .presse-dokument {
      display: flex;
      flex: 1 1 100%;
      align-items: center;
      gap: 2.5em;
    }

    .presse-kachel.presse-zweit { margin-left: 0; }
  }

  @media screen and (max-width: 1080px) {
    .presse-text br { display: none; }
  }

  @media screen and (max-width: 736px) {
    .pressekopf__titel {
      font-size: 2em;
      margin-top: 1.4em;
      margin-bottom: 0.5em;
    }
  }

  /* Die Pressefotos */

  .presse-foto {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2em;
    margin-top: 1.9em;
    padding-top: 0;
  }

  .presse-foto:first-of-type { margin-top: 0; }

  .presse-foto__zeile {
    flex: 1 1 100%;
    display: flex;
    align-items: center;
    gap: 2.5em;
    padding: 0;
  }

  .presse-foto__bild { flex: 0 0 160px; }

  .presse-foto__bild :global(img) {
    width: 100%;
    height: auto;
    margin-top: 2em;
    border-radius: 8px;
  }

  .presse-foto .presse-lade { margin-top: 1em; }

  .presse-foto__text { flex: 1; }

  .presse-foto__text p {
    margin: 2.6em 0 0.7em 0;
    font-size: 0.95em;
    font-weight: 100;
    color: var(--farbe-text);
  }

  .presse-foto__groesse { white-space: nowrap; }

  .presse-foto__nachweis {
    font-size: max(0.9em, 12px);
    color: var(--farbe-akzent-hell);
  }

  /* Kurzbiografie zum Kopieren */

  .presse-bio {
    margin: 0 0 3em;
    padding: 1.5em 1.75em 1.25em;
    border: 1px solid var(--farbe-akzent);
    border-radius: 8px;
    color: var(--farbe-text);
  }

  .presse-bio__kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5em 1em;
    margin-bottom: 0.75em;
  }

  .presse-bio h3 {
    margin: 0;
    font-size: 1.25em;
    color: var(--farbe-akzent);
  }

  .presse-bio__kopieren {
    padding: 0.35em 1em;
    border: 1px solid var(--farbe-akzent);
    border-radius: 999px;
    background: transparent;
    color: var(--farbe-akzent-hell);
    font: inherit;
    font-size: 0.9em;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .presse-bio__kopieren:hover,
  .presse-bio__kopieren:focus-visible {
    background: var(--farbe-akzent);
    color: var(--farbe-grund);
  }

  .presse-bio__text p {
    margin: 0 0 0.9em;
    font-weight: 100;
    text-align: var(--blocksatz);
  }

  .presse-bio__stand {
    margin: 0;
    font-size: max(0.85em, 12px);
    font-style: italic;
    color: var(--farbe-akzent-hell);
  }

  @media screen and (max-width: 480px) {
    .presse-bio { padding: 1.1em 1em 1em; }
  }

  /* Das Ladesymbol wachst beim Ueberfahren leicht an. */

  .presse-lade :global(.presse-symbol) {
    font-size: 1.8em;
    color: var(--farbe-akzent);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .presse-lade:hover :global(.presse-symbol),
  .presse-dokument:hover .presse-lade :global(.presse-symbol) {
    transform: scale(1.2);
    color: var(--farbe-akzent-hell);
  }

  /* Sehr schmale Telefone: kleinere Kacheln, sonst ragt die Zeile hinaus */
  @media screen and (max-width: 360px) {
    .presse-dokument,
    .presse-foto__zeile { gap: 1.25em; }

    .presse-kachel { flex-basis: 112px; height: 80px; }
    .presse-foto__bild { flex-basis: 112px; }
  }

</style>
