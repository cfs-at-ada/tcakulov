---
import type { Vitainhalt } from '../inhalte/vita';
import { naechsteKonzerte, terminTexte } from '../inhalte/termine';
import { datumLang, letzterTag } from '../inhalte/terminformat';
import type { Sprache } from '../inhalte/navigation';

interface Props {
  inhalt: Vitainhalt;
  sprache: Sprache;
}

const { inhalt, sprache } = Astro.props;
---

{/* Alle kommenden Konzerte stehen bereit, sichtbar ist nur das erste.
    Verstreicht es, bevor die Seite neu gebaut ist, rueckt das Skript
    das naechste nach. */}

<section class="konzert">
  <div class="raster raster--konzert">
    <div class="konzert__block" data-konzert-block hidden={naechsteKonzerte.length === 0}>
      <h3 class="konzert__titel">{terminTexte[sprache].naechstes}</h3>
      {naechsteKonzerte.map((t, i) => {
        const ziel = t.link[sprache] || t.link.de;
        const zeilen = [t.titel[sprache], t.zusatz[sprache]].filter(Boolean);
        return (
          <div class="konzert__eintrag" data-konzert data-ende={letzterTag(t)} hidden={i > 0}>
            <p class="konzert__ort">{t.ort[sprache]}, {datumLang(t, sprache)}</p>
            {zeilen.map((zeile) => (
              <p class="konzert__zeile">
                {ziel
                  ? <a class="blanko-verweis" href={ziel} target="_blank" rel="noopener noreferrer">{zeile}</a>
                  : zeile}
              </p>
            ))}
          </div>
        );
      })}
    </div>

    <div class="konzert__zitat">
      {inhalt.zitat.map((zeile) => <p><em>{zeile}</em></p>)}
    </div>
  </div>
</section>

<style>
  .konzert {
    margin: 0;
    padding-bottom: 4em;
  }

  .raster.raster--konzert { margin-top: -20px; }

  .raster > .konzert__block { padding-top: 55px; }

  .konzert__block[hidden],
  .konzert__eintrag[hidden] { display: none; }

  .konzert__titel {
    margin-bottom: 1em;
    padding-bottom: 0;
    font-size: 1.5em;
    font-weight: 400;
    text-align: left;
    color: var(--farbe-akzent);
  }

  .konzert__ort,
  .konzert__zeile {
    margin: 0;
    padding: 0;
    text-align: left;
    color: var(--farbe-text);
  }

  .konzert__ort   { font-weight: 700; }
  .konzert__zeile { font-weight: 100; cursor: pointer; }

  .raster > .konzert__zitat {
    align-self: flex-end;
    margin-left: auto;
    padding-top: 50px;
    text-align: right;
    color: var(--farbe-text);
  }

  .konzert__zitat p {
    margin: 0;
    padding: 0;
    font-weight: 400;
  }
</style>
