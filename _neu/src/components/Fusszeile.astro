---
import { sprachwechsel } from '../inhalte/navigation';
import type { Sprache } from '../inhalte/navigation';

interface Props {
  sprache: Sprache;
  /** Abstand der Trennlinie zum Seiteninhalt – je Seite verschieden. */
  abstandOben: string;
}

const { sprache, abstandOben } = Astro.props;

const impressum = sprache === 'de' ? '/Impressum_Datenschutz.html' : '/Impressum_Datenschutz-en.html';
const impressumText = sprache === 'de' ? 'Impressum & Datenschutz' : 'Legal Notice & Privacy';
---

<footer id="fusszeile">
  <div class="inhalt">
    <hr class="fusszeile-linie" style={`margin-top: ${abstandOben};`} />
  </div>

  <div class="inhalt">
    <div class="fusszeile-verteilung">
      <div class="fusszeile-links">
        <a
          class="icon brands fa-instagram"
          href="https://www.instagram.com/tcakulov/"
          target="_blank"
          rel="noopener noreferrer"
        ><span class="mail-link fusszeile-kennung">@tcakulov</span></a>
      </div>

      <div class="fusszeile-rechts">
        <p>
          Management German Tcakulov<br />
          Constantin Sold<br />
          +49 151 29540528<br />
          <a href="mailto:office@germantcakulov.com" class="mail-link">office@germantcakulov.com</a>
        </p>
      </div>
    </div>
  </div>

  <div id="jumphere" class="inhalt">
    <p class="fusszeile-vermerk">
      © 2025 German Tcakulov ·
      <a href={impressum} class="mail-link">{impressumText}</a>
    </p>
  </div>
</footer>

<style>
  #fusszeile {
    margin-top: 0;
    padding: 0;
    text-align: center;
    background: var(--farbe-grund);
    color: var(--farbe-akzent-hell);
  }

  #fusszeile :global(.inhalt) {
    max-width: 52em;
    margin: 0 auto;
    padding: 0;
    color: var(--farbe-akzent-hell);
  }

  .fusszeile-linie {
    margin-bottom: 4.25em;
  }

  .fusszeile-verteilung {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2em;
  }

  .fusszeile-links a {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.21em;
    margin-right: 0;
    padding-bottom: 0.15em;
    font-size: 3em;
    font-weight: 100;
    color: inherit;
    text-decoration: none;
  }

  .fusszeile-kennung {
    margin-left: -0.8em;
    font-size: 0.375em;
    font-weight: 100;
    color: var(--farbe-akzent);
    cursor: pointer;
  }

  .fusszeile-rechts p {
    margin: 0 0 3.15em 0;
    font-size: 0.9em;
    font-weight: 100;
    line-height: 1.25;
    text-align: right;
    color: var(--farbe-akzent);
  }

  .fusszeile-vermerk {
    font-size: 0.9em;
    font-weight: 100;
    text-align: center;
    color: var(--farbe-akzent);
  }

  @media screen and (max-width: 700px) {
    .fusszeile-verteilung {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .fusszeile-rechts p { text-align: center; }
  }
</style>
