---
/**
 * Das seitenhohe Titelbild mit dem Namenszug.
 * Bildausschnitt und Verankerung sind je Seite eigens gesetzt; darum
 * traegt jede Fassung eine eigene Kennzeichnung.
 */
import { titelbilder, titelbildFassungen, type Titelseite } from '../inhalte/bilder';

interface Props {
  seite: Titelseite;
}

const { seite } = Astro.props;
// Drei Groessen je Bild, jeweils WebP mit JPEG als Rueckfall
const fassungen = await titelbildFassungen(titelbilder[seite]);
---

<div class:list={['titelbild', `titelbild--${seite}`]} style={fassungen}>
  <div class="titelbild__grund" aria-hidden="true"></div>
  <div class="titelbild__name">GERMAN <br /> TCAKULOV</div>
  <div class="titelbild__unterschrift">German<br />Tcakulov<small>Viola</small></div>
</div>


<style>
  .titelbild {
    position: relative;
    overflow: hidden;
    height: 100vh;
    background-repeat: no-repeat;
    background-size: cover;
    --titel-bild: var(--titel-gross-jpg);
  }

  @media screen and (max-width: 1280px) {
    .titelbild { --titel-bild: var(--titel-mittel-jpg); }
  }

  @media screen and (max-width: 736px) {
    .titelbild { --titel-bild: var(--titel-klein-jpg); }
  }

  /* WebP, wo der Browser die Auswahl nach Dateityp beherrscht */
  @supports (background-image: image-set(url("x.webp") type("image/webp"))) {
    .titelbild { --titel-bild: var(--titel-gross); }

    @media screen and (max-width: 1280px) {
      .titelbild { --titel-bild: var(--titel-mittel); }
    }

    @media screen and (max-width: 736px) {
      .titelbild { --titel-bild: var(--titel-klein); }
    }
  }

  /* Das Bild malt eine eigene Ebene. Wo es beim Blaettern stehen bleibt,
     ist diese Ebene fest am Fenster verankert und auf das Titelbild
     zugeschnitten. Das sieht aus wie `background-attachment: fixed`, wird
     aber von der Grafikkarte verschoben statt bei jedem Bildlauf neu
     gezeichnet – und ruckelt darum nicht. */
  .titelbild__grund {
    position: absolute;
    inset: 0;
    clip-path: inset(0);
    background-size: inherit;
    background-position: inherit;
    background-repeat: inherit;
  }

  .titelbild__grund::before {
    content: '';
    position: var(--titel-lage, absolute);
    inset: 0;
    background-image: var(--titel-bild);
    background-size: inherit;
    background-position: inherit;
    background-repeat: inherit;
    will-change: transform;
  }

  .titelbild__unterschrift { display: none; }

  .titelbild__name {
    position: fixed;
    top: 40vh;
    right: 3.1vw;
    z-index: 0;
    color: var(--farbe-grund);
    text-align: right;
    line-height: 0.9em;
    letter-spacing: -0.05em;
    transition: opacity 0.75s ease;
    /* Der Namenszug ist Zierrat. Er steht fest im Bild und liegt beim
       Blaettern ueber dem Inhalt darunter – auch noch, wenn er laengst
       ausgeblendet ist. Ohne diese Zeile faengt er dort Klicks ab. */
    pointer-events: none;
  }

  /* Unterhalb von 1080px verdeckt die Titelleiste den Namenszug. */
  @media screen and (max-width: 1080px) {
    .titelbild__name { display: none; }
  }

  /* --- Vita ------------------------------------------------------------- */

  .titelbild--vita {
    background-position: 50% 30%;
    --titel-lage: fixed;
    margin-bottom: 30px;
  }

  .titelbild--vita .titelbild__name { font-size: 5em; }

  @media screen and (min-width: 737px) and (max-width: 1080px) {
    .titelbild--vita {
      max-height: 95vh;
      background-position: 40% 5%;
      --titel-lage: absolute;
    }
  }

  @media screen and (max-width: 736px) {
    .titelbild--vita {
      max-height: 60vh;
      background-position: 36% top;
      --titel-lage: absolute;
    }
  }

  /* --- Termine ---------------------------------------------------------- */

  .titelbild--termine {
    width: 100%;
    background-position: center;
    --titel-lage: fixed;
    margin-bottom: 3em;
  }

  .titelbild--termine .titelbild__name { font-size: 5em; }

  @media screen and (min-width: 737px) and (max-width: 1080px) {
    .titelbild--termine {
      background-position: 30% top;
      --titel-lage: absolute;
    }
  }

  @media screen and (max-width: 736px) {
    .titelbild--termine {
      max-height: 60vh;
      background-size: 250%;
      background-position: 40% 45%;
      --titel-lage: absolute;
    }
  }

  @media screen and (min-width: 560px) and (max-width: 736px) {
    .titelbild--termine { background-size: 200%; }
  }

  /* --- Lehre ------------------------------------------------------------ */

  .titelbild--lehre {
    background-size: 120%;
    background-position: 90% 65%;
    --titel-lage: fixed;
    margin-bottom: 45px;
  }

  .titelbild--lehre .titelbild__name { font-size: 4em; }

  @media screen and (min-width: 1081px) and (max-width: 1180px) {
    .titelbild--lehre .titelbild__name { font-size: 3.75em; }
  }

  @media screen and (min-width: 1000px) and (max-width: 1080px) {
    .titelbild--lehre {
      max-height: 60vh;
      background-size: 100%;
      background-position: 65% 80%;
      --titel-lage: absolute;
    }
  }

  @media screen and (min-width: 737px) and (max-width: 1000px) {
    .titelbild--lehre {
      max-height: 60vh;
      background-size: 100%;
      background-position: 65% 90%;
      --titel-lage: absolute;
    }
  }

  @media screen and (min-width: 551px) and (max-width: 736px) {
    .titelbild--lehre {
      max-height: 60vh;
      background-size: 150%;
      background-position: 65% 70%;
      --titel-lage: absolute;
    }
  }

  @media screen and (max-width: 550px) {
    .titelbild--lehre {
      max-height: 60vh;
      background-size: 200%;
      background-position: 65% 70%;
      --titel-lage: absolute;
    }
  }

  /* --- Media ------------------------------------------------------------ */

  .titelbild--media {
    background-position: center;
    --titel-lage: fixed;
    margin-bottom: 3em;
  }

  .titelbild--media .titelbild__name { font-size: 5em; }

  @media screen and (min-width: 1080px) and (max-width: 1180px) {
    .titelbild--media .titelbild__name { font-size: 4.3em; }
  }

  @media screen and (min-width: 736px) and (max-width: 1080px) {
    .titelbild--media { background-position: 57% 70%; }
  }

  @media screen and (max-width: 736px) {
    .titelbild--media {
      max-height: 60vh;
      background-size: 200%;
      background-position: 57% 70%;
      --titel-lage: absolute;
    }
  }

  /* --- Kontakt ---------------------------------------------------------- */

  .titelbild--kontakt {
    background-position: 50% 30%;
    --titel-lage: absolute;
    margin-bottom: 3em;
  }

  .titelbild--kontakt .titelbild__name { font-size: 5em; }

  @media screen and (min-width: 737px) and (max-width: 1080px) {
    .titelbild--kontakt { background-position: 40% top; }
  }

  @media screen and (max-width: 736px) {
    .titelbild--kontakt {
      max-height: 60vh;
      background-position: 36% top;
    }
  }

  /* --- Geraeteabhaengige Nachbesserungen -------------------------------- */
  /* Querformat auf Tablet und Telefon: dort traegt `background-attachment:
     fixed` nicht, deshalb ein eigener Ausschnitt. Reihenfolge und
     Gewichtung entsprechen der alten Seite.                               */

  @media only screen and (orientation: landscape) {
    :global(html.is-ipad) .titelbild--vita {
      --titel-lage: absolute;
      background-size: 110%;
      background-position: left top;
      margin-bottom: -25px;
      max-width: 100vw;
      max-height: 100vh;
    }

    :global(html.is-ipad) .titelbild--termine {
      --titel-lage: absolute;
      background-size: 110%;
      background-position: left top;
      max-width: 100vw;
      max-height: 100vh;
    }

    :global(html.is-ipad) .titelbild--lehre {
      --titel-lage: absolute;
      background-size: 110%;
      background-position: right bottom;
      max-width: 100vw;
      max-height: 100vh;
    }

    :global(html.is-ipad) .titelbild--lehre .titelbild__name { font-size: 4em; }

    :global(html.is-ipad) .titelbild--media {
      --titel-lage: absolute;
      background-size: 110%;
      background-position: right top;
      max-width: 100vw;
      max-height: 100vh;
    }
  }

  @media only screen and (orientation: portrait) {
    :global(html.is-ipad) .titelbild--media {
      --titel-lage: absolute;
      background-size: 190%;
      background-position: 55% top;
      margin-bottom: -46px;
      max-width: 100vw;
      max-height: 100vh;
    }
  }

  @media only screen and (orientation: landscape) {
    :global(html.is-mobile) .titelbild--vita,
    :global(html.is-mobile) .titelbild--kontakt,
    :global(html.is-mobile) .titelbild--media {
      background-size: 100%;
      background-position: center top;
      width: 100vw;
      height: 100vh;
      max-height: 100vh;
    }

    :global(html.is-mobile) .titelbild--termine {
      background-size: 100%;
      background-position: center top;
      width: 100vw;
      height: 100vh;
      max-height: 100vh;
    }

    :global(html.is-mobile) .titelbild--lehre {
      background-size: 100%;
      background-position: center 70%;
      width: 100vw;
      height: 100vh;
      max-height: 100vh;
    }
  }

  /* --- Schmale Ansicht: Bild ueber den ganzen Schirm -------------------- */
  /* Unterhalb von 1080px beginnt die Seite ohne Leiste direkt mit dem Bild.
     Es fuellt den Schirm, laeuft unten ins Nachtblau aus und traegt dort den
     Namen. Der vorangestellte `html`-Selektor sticht die Geraeteregeln oben. */

  @media screen and (max-width: 1080px) {
    :global(html) .titelbild:is(.titelbild--vita, .titelbild--termine, .titelbild--lehre, .titelbild--media, .titelbild--kontakt) {
      --titel-lage: absolute;
      width: 100%;
      max-width: none;
      height: 100vh;
      height: 100svh;
      max-height: none;
      background-size: cover;
    }

    /* Der Ausschnitt rueckt ihn jeweils in die Mitte. Wo er im Bild klein
       ist, wird etwas hineingezoomt. */
    :global(html) .titelbild.titelbild--vita    { background-position: 32% 20%; margin-bottom: 30px; }
    :global(html) .titelbild.titelbild--kontakt { background-position: 32% 20%; margin-bottom: 3em; }
    :global(html) .titelbild.titelbild--lehre   { background-position: 58% 30%; margin-bottom: 45px; }
    :global(html) .titelbild.titelbild--termine { background-size: auto 150%; background-position: 41% 41%; margin-bottom: 3em; }
    :global(html) .titelbild.titelbild--media   { background-size: auto 150%; background-position: 38% 80%; margin-bottom: 3em; }

    /* Oben ein leiser Schatten, damit der Menueknopf auf hellem Himmel
       lesbar bleibt; unten der Uebergang ins Nachtblau. */
    .titelbild::before,
    .titelbild::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      z-index: 1;
      pointer-events: none;
    }

    .titelbild::before {
      top: 0;
      height: 110px;
      background: linear-gradient(rgba(0, 25, 40, 0.5), rgba(0, 25, 40, 0));
    }

    .titelbild::after {
      bottom: -1px;
      height: 45%;
      background: linear-gradient(rgba(0, 48, 73, 0), var(--farbe-grund));
    }

    .titelbild__unterschrift {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(44px + env(safe-area-inset-bottom, 0px));
      z-index: 2;
      /* Die Sperrung haengt rechts an; links ausgeglichen steht der Name mittig. */
      padding-left: 0.22em;
      font-size: clamp(30px, 3.6vw + 16px, 46px);
      font-weight: 200;
      line-height: 1.15;
      letter-spacing: 0.22em;
      text-align: center;
      text-transform: uppercase;
      color: var(--farbe-text);
    }

    .titelbild__unterschrift small {
      display: block;
      margin-top: 0.4em;
      padding-left: 0.4em;
      margin-left: -0.22em;
      font-size: max(11px, 0.36em);
      font-weight: 400;
      letter-spacing: 0.4em;
      color: var(--farbe-akzent);
    }
  }

  /* Niedrige Fenster (Telefon quer): Name etwas kleiner und tiefer. */
  @media screen and (max-width: 1080px) and (max-height: 480px) {
    .titelbild__unterschrift { bottom: 24px; font-size: 26px; }
  }
</style>
