---
import { navigation, sprachwechsel } from '../inhalte/navigation';
import type { Seitenschluessel, Sprache } from '../inhalte/navigation';

interface Props {
  sprache: Sprache;
  /** Welcher Punkt als aktiv markiert wird. */
  aktiv?: Seitenschluessel;
  /** Seite, auf der die Navigation steht – bestimmt das Sprachgegenstueck. */
  seite: Seitenschluessel;
  /**
   * Sprungmarke, auf die der aktive Punkt zeigt. Fehlt sie, bleibt der
   * aktive Punkt ein gewoehnlicher Verweis auf seine Seite.
   */
  marke?: string;
}

const { sprache, aktiv, seite, marke } = Astro.props;
const punkte = navigation[sprache];
---

<nav id="hauptnavigation">
  <ul>
    {punkte.map((punkt) => {
      const istAktiv = punkt.schluessel === aktiv;
      const ziel = istAktiv && marke ? marke : punkt.ziel;
      return (
        <li>
          <a href={ziel} class={istAktiv ? 'aktiv' : undefined}>{punkt.text}</a>
        </li>
      );
    })}
    <li class="sprachwechsel">
      <a href={sprachwechsel[sprache][seite]}>DE | EN</a>
    </li>
  </ul>
</nav>

<style>
  #hauptnavigation {
    position: fixed;
    bottom: 2.75vh;
    right: 1vw;
    left: auto;
    top: auto;
    width: auto;
    text-align: right;
    text-transform: uppercase;
    cursor: default;
  }

  #hauptnavigation ul {
    position: relative;
    z-index: 1001;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.3em;
    font-weight: 100;
  }

  #hauptnavigation li {
    display: block;
    margin: 0;
    position: relative;
    top: 0;
    line-height: 0.6em;
    transition: top 0.15s ease-in-out;
  }

  #hauptnavigation li.sprachwechsel {
    padding-top: 1em;
  }

  #hauptnavigation a {
    position: relative;
    display: block;
    top: -6px;
    padding: 6px 1.5em 0.25em 1.5em;
    color: var(--farbe-text);
    text-decoration: none;
    outline: 0;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    transition: background-color 0.075s ease-in-out, color 0.075s ease-in-out;
  }

  #hauptnavigation li:hover { top: 3px; }
  #hauptnavigation li:hover a { background: transparent; color: var(--farbe-akzent-hell); }

  #hauptnavigation a.aktiv { color: var(--farbe-akzent); }
  #hauptnavigation a.aktiv:hover { color: var(--farbe-akzent-hell); }

  /* Unterhalb von 1080px uebernimmt die Menuetafel. */
  @media screen and (max-width: 1080px) {
    #hauptnavigation { display: none; }
  }
</style>
