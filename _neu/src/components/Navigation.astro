---
import { navigation, sprachwechsel } from '../inhalte/navigation';
import type { Seitenschluessel, Sprache } from '../inhalte/navigation';

interface Props {
  sprache: Sprache;
  /** Welcher Punkt als aktiv markiert wird. */
  aktiv?: Seitenschluessel;
  /** Seite, auf der die Navigation steht – bestimmt das Sprachgegenstueck. */
  seite: Seitenschluessel;
  /**
   * Sprungmarke, auf die der aktive Punkt zeigt. Fehlt sie, bleibt der
   * aktive Punkt ein gewoehnlicher Verweis auf seine Seite.
   */
  marke?: string;
}

const { sprache, aktiv, seite, marke } = Astro.props;
const punkte = navigation[sprache];
const andere: Sprache = sprache === 'de' ? 'en' : 'de';
---

{/* Breite Fassung: die Menuepunkte als feine Zeile unten rechts im
    Titelbild. Seiten ohne Titelbild tragen sie oben rechts. */}
<nav id="hauptnavigation">
  <ul>
    {punkte.map((punkt) => {
      const istAktiv = punkt.schluessel === aktiv;
      const ziel = istAktiv && marke ? marke : punkt.ziel;
      return (
        <li>
          <a href={ziel} class={istAktiv ? 'aktiv' : undefined}>{punkt.text}</a>
        </li>
      );
    })}
    <li class="sprachwechsel">
      <a href={sprachwechsel[sprache][seite]} hreflang={andere} lang={andere}>{andere.toUpperCase()}</a>
    </li>
  </ul>
</nav>

<style>
  #hauptnavigation {
    position: absolute;
    top: calc(100vh - 78px);
    right: 64px;
    z-index: 6;
  }

  :global(body.ohne-titelbild) #hauptnavigation { top: 44px; }

  #hauptnavigation ul {
    display: flex;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #hauptnavigation li { margin: 0; padding: 0; }

  #hauptnavigation a {
    display: block;
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--farbe-text);
    transition: color 0.2s ease;
  }

  #hauptnavigation a.aktiv,
  #hauptnavigation .sprachwechsel a { color: var(--farbe-akzent); }

  #hauptnavigation a:hover { color: var(--farbe-akzent-hell); }

  /* Unterhalb von 1080px uebernimmt die Menuetafel. */
  @media screen and (max-width: 1080px) {
    #hauptnavigation { display: none; }
  }
</style>
