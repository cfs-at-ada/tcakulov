---
/**
 * Zwei-Klick-Einbettung: Bis zum Klick steht hier nur ein Vorschaubild vom
 * eigenen Server. Erst der Klick setzt den Player von YouTube bzw. Spotify
 * ein (skripte/einbettung.ts). Ohne JavaScript fuehrt der Knopf direkt zum
 * Dienst.
 */
import { Image } from 'astro:assets';
import { medienTexte, type Einbettung } from '../inhalte/medien';
import { sprachwechsel, type Sprache } from '../inhalte/navigation';

interface Props {
  eintrag: Einbettung;
  sprache: Sprache;
}

const { eintrag, sprache } = Astro.props;
const texte = medienTexte[sprache];
const dienst = eintrag.art === 'youtube' ? 'YouTube' : 'Spotify';
const ziel = eintrag.art === 'youtube'
  ? `${eintrag.quelle}?autoplay=1`
  : eintrag.quelle;
const direkt = eintrag.art === 'youtube'
  ? eintrag.quelle.replace('youtube-nocookie.com/embed/', 'youtube.com/watch?v=')
  : eintrag.quelle.replace('/embed/', '/');
// Die Datenschutzerklaerung steht auf der Impressumsseite der jeweils gleichen Sprache.
const datenschutz = `${sprachwechsel[sprache === 'de' ? 'en' : 'de'].impressum}#datenschutz`;
---

<div
  class:list={['einbettung', `einbettung--${eintrag.art}`]}
  data-einbettung={ziel}
  data-titel={eintrag.titel}
  data-art={eintrag.art}
>
  <Image
    class="einbettung__bild"
    src={eintrag.vorschau}
    alt=""
    widths={eintrag.art === 'youtube' ? [480, 800, 1280] : [300, 640]}
    sizes={eintrag.art === 'youtube' ? '(max-width: 980px) 100vw, 420px' : '150px'}
    format="webp"
    quality={82}
    loading="lazy"
  />
  <div class="einbettung__schicht">
    <a class="einbettung__knopf" href={direkt} data-einbettung-start target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      <span>{eintrag.art === 'youtube' ? texte.abspielen : texte.hoeren}</span>
    </a>
    {eintrag.art === 'spotify' && <span class="einbettung__titel">{eintrag.titel}</span>}
    <span class="einbettung__hinweis">
      {texte.hinweis(dienst)} <a href={datenschutz}>{texte.datenschutz}</a>
    </span>
  </div>
</div>

<style>
  .einbettung {
    position: relative;
    overflow: hidden;
    background: #000;
    color: var(--farbe-text);
  }

  .einbettung--youtube { aspect-ratio: 3 / 2; }

  .einbettung--spotify {
    display: flex;
    height: 300px;
    border-radius: 12px;
    background: #1f1f1f;
  }

  .einbettung__bild {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .einbettung--spotify .einbettung__bild {
    flex: 0 0 auto;
    width: auto;
    height: 100%;
    aspect-ratio: 1;
    opacity: 0.9;
  }

  .einbettung__schicht {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75em;
    padding: 1em;
    text-align: center;
  }

  .einbettung--spotify .einbettung__schicht {
    position: static;
    flex: 1 1 auto;
    align-items: flex-start;
    text-align: left;
    padding: 1.25em 1.5em;
  }

  .einbettung__knopf {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6em 1.2em 0.6em 0.9em;
    border: 2px solid var(--farbe-akzent);
    border-radius: 999px;
    background: rgba(0, 48, 73, 0.85);
    color: var(--farbe-text);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .einbettung__knopf:hover,
  .einbettung__knopf:focus-visible { background: var(--farbe-akzent); }

  .einbettung__knopf svg { width: 1.4em; height: 1.4em; }

  .einbettung__titel {
    font-weight: 700;
    line-height: 1.3;
  }

  .einbettung__hinweis {
    max-width: 28em;
    font-size: max(0.8em, 12px);
    line-height: 1.35;
    color: var(--farbe-akzent-hell);
  }

  .einbettung__hinweis a { color: inherit; }

  .einbettung :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media screen and (max-width: 480px) {
    .einbettung--spotify { flex-direction: column; height: auto; }
    .einbettung--spotify .einbettung__bild { width: 100%; height: auto; max-height: 180px; object-fit: cover; }
    .einbettung--spotify.ist-geladen { height: 352px; }
  }
</style>
