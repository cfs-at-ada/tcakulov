---
import { navigation, sprachwechsel } from '../inhalte/navigation';
import type { Seitenschluessel, Sprache } from '../inhalte/navigation';

interface Props {
  sprache: Sprache;
  seite: Seitenschluessel;
  aktiv?: Seitenschluessel;
  marke?: string;
  /** Seiten ohne Titelbild tragen den Namen klein oben links. */
  mitTitelbild: boolean;
}

const { sprache, seite, aktiv, marke, mitTitelbild } = Astro.props;
const punkte = navigation[sprache];
const knopf = sprache === 'de' ? { zu: 'Menü', offen: 'Schließen' } : { zu: 'Menu', offen: 'Close' };
const andere: Sprache = sprache === 'de' ? 'en' : 'de';
---

{/* Schmale Fassung der Navigation: Ein schlichtes „Menü“ oben rechts
    oeffnet eine ruhige Vollbildtafel. Ohne Skript fuehrt der Verweis per
    Sprungmarke zur Tafel, die dann per :target sichtbar wird. */}

{!mitTitelbild && <a class="kopfname" href={punkte[0].ziel}>German Tcakulov</a>}

<a class="menueknopf" href="#menuetafel" aria-controls="menuetafel" aria-expanded="false"
   data-zu={knopf.zu} data-offen={knopf.offen}>{knopf.zu}</a>

<div id="menuetafel">
  <nav>
    {punkte.map((punkt) => (
      <a class:list={['verweis', { aktiv: punkt.schluessel === aktiv }]}
         href={punkt.schluessel === aktiv && marke ? marke : punkt.ziel}>{punkt.text}</a>
    ))}
  </nav>
  <div class="sprachen">
    <span aria-current="true">{sprache.toUpperCase()}</span>
    <span aria-hidden="true">·</span>
    <a href={sprachwechsel[sprache][seite]} hreflang={andere} lang={andere}>{andere.toUpperCase()}</a>
  </div>
</div>

<style>
  .kopfname,
  .menueknopf,
  #menuetafel {
    display: none;
  }

  /* Schmal steht der Knopf immer da, breit erst, wenn die Menuezeile im
     Titelbild aus dem Blick ist. Die Tafel selbst gilt fuer alle Breiten. */
  @media screen {
    .menueknopf {
      display: block;
      position: fixed;
      top: calc(10px + env(safe-area-inset-top, 0px));
      right: calc(8px + env(safe-area-inset-right, 0px));
      z-index: 10003;
      padding: 12px 16px;
      border-radius: 999px;
      font-family: var(--schrift);
      font-size: clamp(11px, 0.5vw + 9px, 14px);
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      text-decoration: none;
      color: #fff;
      -webkit-tap-highlight-color: transparent;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* Ueber dem Text bekommt der Knopf einen leisen Glasgrund. */
    :global(body.ueber-inhalt) .menueknopf {
      background-color: rgba(0, 48, 73, 0.72);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      color: var(--farbe-akzent-hell);
    }

    :global(body.menue-offen) .menueknopf {
      background-color: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      color: var(--farbe-akzent-hell);
    }

    .kopfname {
      display: block;
      position: absolute;
      top: calc(22px + env(safe-area-inset-top, 0px));
      left: calc(22px + env(safe-area-inset-left, 0px));
      z-index: 2;
      font-family: var(--schrift);
      font-size: 13px;
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--farbe-akzent-hell);
    }

    #menuetafel {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: fixed;
      inset: 0;
      z-index: 10002;
      padding: 80px 20px;
      overflow-y: auto;
      background-color: var(--farbe-grund);
      font-family: var(--schrift);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s ease, visibility 0s linear 0.35s;
    }

    :global(body.menue-offen) { overflow: hidden; }

    :global(body.menue-offen) #menuetafel,
    #menuetafel:target {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.35s ease;
    }

    #menuetafel nav {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(26px, 2vw + 18px, 40px);
    }

    #menuetafel .verweis {
      /* Die Sperrung haengt rechts an; links ausgeglichen sitzt das Wort mittig. */
      padding-left: 0.3em;
      font-size: clamp(20px, 1.4vw + 15px, 30px);
      font-weight: 300;
      line-height: 1.2;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--farbe-text);
      -webkit-tap-highlight-color: transparent;
    }

    #menuetafel .verweis.aktiv { color: var(--farbe-akzent); }

    #menuetafel .sprachen {
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(40px + env(safe-area-inset-bottom, 0px));
      display: flex;
      justify-content: center;
      gap: 0.9em;
      font-size: clamp(12px, 0.4vw + 10px, 15px);
      letter-spacing: 0.3em;
      color: var(--farbe-akzent);
    }

    #menuetafel .sprachen a {
      color: var(--farbe-akzent-hell);
      text-decoration: none;
    }

    #menuetafel .sprachen [aria-current] { color: var(--farbe-akzent); }
  }

  @media screen and (min-width: 1081px) {
    .menueknopf {
      top: 22px;
      right: 40px;
      padding: 13px 20px;
      font-size: 12px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0s linear 0.3s, background-color 0.3s ease, color 0.3s ease;
    }

    :global(body.ueber-inhalt) .menueknopf,
    :global(body.menue-offen) .menueknopf {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    }

    .menueknopf:hover { color: var(--farbe-text); }

    .kopfname {
      top: 44px;
      left: 64px;
      font-size: 12px;
      letter-spacing: 0.28em;
    }

    #menuetafel .verweis:hover,
    #menuetafel .sprachen a:hover { color: var(--farbe-akzent-hell); }
  }

  /* Niedrige Fenster (Telefon quer): Sprachwahl folgt der Liste. */
  @media screen and (max-width: 1080px) and (max-height: 480px) {
    #menuetafel { justify-content: flex-start; padding-top: 56px; }
    #menuetafel nav { gap: 14px; }
    #menuetafel .sprachen { position: static; margin-top: 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #menuetafel, .menueknopf { transition: none; }
  }
</style>
